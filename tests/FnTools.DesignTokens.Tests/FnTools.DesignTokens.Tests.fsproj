<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FnTools.DesignTokens.Tests</RootNamespace>
    <AssemblyName>FnTools.DesignTokens.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="Generators.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="ParseTests.fs" />
    <Compile Include="VersionTests.fs" />
    <Compile Include="FlattenTests.fs" />
    <Compile Include="ResolverTests.fs" />
    <Compile Include="SimpleApiTests.fs" />
    <Compile Include="PropertyTests.fs" />
    <Compile Include="SmokeTests.fs" />
    <Compile Include="CssEmitterTests.fs" />
    <Compile Include="BindingsEmitterTests.fs" />
    <Compile Include="CssIngestTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="10.*" />
    <PackageReference Include="Hedgehog" Version="0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FnTools.DesignTokens\FnTools.DesignTokens.fsproj" />
  </ItemGroup>
</Project>
