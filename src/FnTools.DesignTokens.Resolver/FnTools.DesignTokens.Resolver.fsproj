<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FnTools.DesignTokens</RootNamespace>
    <AssemblyName>FnTools.DesignTokens.Resolver</AssemblyName>
    <PackageId>FnTools.DesignTokens.Resolver</PackageId>
    <Version>0.1.0</Version>
    <Authors>FnTools</Authors>
    <Description>DTCG 2025.10 multi-set / modifier resolver document semantics</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://forgejo.ivanthegeek.com/FnTools/FnTools.DesignTokens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>FS3261</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Resolver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FnTools.DesignTokens.Foundation\FnTools.DesignTokens.Foundation.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.Format\FnTools.DesignTokens.Format.fsproj" />
  </ItemGroup>
</Project>
