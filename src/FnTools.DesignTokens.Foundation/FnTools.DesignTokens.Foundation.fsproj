<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FnTools.DesignTokens</RootNamespace>
    <AssemblyName>FnTools.DesignTokens.Foundation</AssemblyName>
    <PackageId>FnTools.DesignTokens.Foundation</PackageId>
    <Version>0.2.0</Version>
    <Authors>FnTools</Authors>
    <Description>DTCG 2025.10 design token domain types and smart constructors</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://forgejo.ivanthegeek.com/FnTools/FnTools.DesignTokens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Errors.fs" />
    <Compile Include="Domain.fs" />
  </ItemGroup>
</Project>
