<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FnTools.DesignTokens</RootNamespace>
    <AssemblyName>FnTools.DesignTokens</AssemblyName>
    <PackageId>FnTools.DesignTokens</PackageId>
    <Version>0.6.0</Version>
    <Authors>FnTools</Authors>
    <Description>DTCG 2025.10 design token library — meta-package combining all layers</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://forgejo.ivanthegeek.com/FnTools/FnTools.DesignTokens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DesignTokens.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FnTools.DesignTokens.Foundation\FnTools.DesignTokens.Foundation.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.Format\FnTools.DesignTokens.Format.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.Validation\FnTools.DesignTokens.Validation.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.Resolver\FnTools.DesignTokens.Resolver.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.Css\FnTools.DesignTokens.Css.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.Bindings\FnTools.DesignTokens.Bindings.fsproj" />
    <ProjectReference Include="..\FnTools.DesignTokens.TokensStudio\FnTools.DesignTokens.TokensStudio.fsproj" />
  </ItemGroup>
</Project>
